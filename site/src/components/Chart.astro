---
// Small server-rendered SVG chart: lines, dots and reference lines. No client JS.
type Series = {
  name: string;
  points: [number, number][];
  color: string;
  kind?: 'line' | 'dots' | 'dash' | 'both';
  err?: number[]; // symmetric error bars, same units as y
  dx?: number; // small horizontal offset so overlapping series stay readable
};
type Ref = { value: number; label: string; color?: string };
interface Props {
  series: Series[];
  xLabel: string;
  yLabel: string;
  logY?: boolean;
  hRefs?: Ref[];
  vRefs?: Ref[];
  xMin?: number;
  yMin?: number;
  yMax?: number;
  height?: number;
  title: string;
}
const { series, xLabel, yLabel, logY = false, hRefs = [], vRefs = [], height = 300, title } = Astro.props;

const W = 560, H = height, L = 64, R = 16, T = 16, B = 44;
const f = (y: number) => (logY ? Math.log10(y) : y);
const xs = series.flatMap((s) => s.points.map((p) => p[0])).concat(vRefs.map((r) => r.value));
const ys = series
  .flatMap((s) => s.points.flatMap((p, i) => (s.err ? [f(p[1] - s.err[i]), f(p[1] + s.err[i])] : [f(p[1])])))
  .concat(hRefs.map((r) => f(r.value)));
const x0 = Astro.props.xMin ?? Math.min(...xs), x1 = Math.max(...xs);
let y0 = Astro.props.yMin !== undefined ? f(Astro.props.yMin) : Math.min(...ys);
let y1 = Astro.props.yMax !== undefined ? f(Astro.props.yMax) : Math.max(...ys);
const pad = (y1 - y0) * 0.06; y0 -= pad; y1 += pad;
const sx = (x: number) => L + ((x - x0) / (x1 - x0)) * (W - L - R);
const sy = (y: number) => T + (1 - (f(y) - y0) / (y1 - y0)) * (H - T - B);

function ticks(a: number, b: number, n = 5) {
  const step = Math.pow(10, Math.floor(Math.log10((b - a) / n)));
  const m = [1, 2, 5, 10].find((k) => (b - a) / (k * step) <= n) ?? 10;
  const s = m * step, out: number[] = [];
  for (let v = Math.ceil(a / s) * s; v <= b + 1e-12; v += s) out.push(+v.toFixed(10));
  return out;
}
const xt = ticks(x0, x1);
const yt = logY
  ? Array.from({ length: Math.floor(y1) - Math.ceil(y0) + 1 }, (_, i) => Math.ceil(y0) + i)
  : ticks(y0, y1);
const fmtY = (v: number) => (logY ? `10${String(v).replace('-', '⁻').replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])}` : v.toFixed(Math.max(0, -Math.floor(Math.log10(Math.abs(yt[1] - yt[0] || 1))))));
const yPix = (v: number) => (logY ? T + (1 - (v - y0) / (y1 - y0)) * (H - T - B) : sy(v));
const path = (pts: [number, number][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${sx(p[0]).toFixed(1)},${sy(p[1]).toFixed(1)}`).join('');
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    <title>{title}</title>
    {yt.map((v) => (
      <g>
        <line x1={L} x2={W - R} y1={yPix(v)} y2={yPix(v)} class="grid" />
        <text x={L - 8} y={yPix(v) + 4} text-anchor="end" class="tick">{fmtY(v)}</text>
      </g>
    ))}
    {xt.map((v) => <text x={sx(v)} y={H - B + 18} text-anchor="middle" class="tick">{v}</text>)}
    <line x1={L} x2={W - R} y1={H - B} y2={H - B} class="axis" />
    <text x={(L + W - R) / 2} y={H - 6} text-anchor="middle" class="label">{xLabel}</text>
    <text x={14} y={(T + H - B) / 2} text-anchor="middle" class="label" transform={`rotate(-90 14 ${(T + H - B) / 2})`}>{yLabel}</text>
    {hRefs.map((r) => (
      <g>
        <line x1={L} x2={W - R} y1={sy(r.value)} y2={sy(r.value)} class="ref" stroke={r.color ?? 'var(--bad)'} />
        <text x={W - R - 4} y={sy(r.value) - 5} text-anchor="end" class="reflabel" fill={r.color ?? 'var(--bad)'}>{r.label}</text>
      </g>
    ))}
    {vRefs.map((r) => (
      <g>
        <line x1={sx(r.value)} x2={sx(r.value)} y1={T} y2={H - B} class="ref" stroke={r.color ?? 'var(--ink-faint)'} />
        <text x={sx(r.value) + 5} y={T + 12} class="reflabel" fill={r.color ?? 'var(--ink-faint)'}>{r.label}</text>
      </g>
    ))}
    {series.map((s) => (
      <g>
        {(s.kind ?? 'line') !== 'dots' && (
          <path d={path(s.points)} fill="none" stroke={s.color} stroke-width="2.2" stroke-dasharray={s.kind === 'dash' ? '6 5' : undefined} />
        )}
        {s.err && s.points.map((p, i) => (
          <g stroke={s.color} stroke-width="1.5">
            <line x1={sx(p[0]) + (s.dx ?? 0)} x2={sx(p[0]) + (s.dx ?? 0)} y1={sy(p[1] - s.err![i])} y2={sy(p[1] + s.err![i])} />
            <line x1={sx(p[0]) + (s.dx ?? 0) - 4} x2={sx(p[0]) + (s.dx ?? 0) + 4} y1={sy(p[1] - s.err![i])} y2={sy(p[1] - s.err![i])} />
            <line x1={sx(p[0]) + (s.dx ?? 0) - 4} x2={sx(p[0]) + (s.dx ?? 0) + 4} y1={sy(p[1] + s.err![i])} y2={sy(p[1] + s.err![i])} />
          </g>
        ))}
        {(s.kind === 'dots' || s.kind === 'both') && s.points.map((p) => <circle cx={sx(p[0]) + (s.dx ?? 0)} cy={sy(p[1])} r="4.5" fill={s.color} stroke="var(--card)" stroke-width="1.5" />)}
      </g>
    ))}
  </svg>
  <figcaption class="legend">
    {series.map((s) => <span><i style={`background:${s.color}`} class={s.kind === 'dash' ? 'dash' : ''}></i>{s.name}</span>)}
  </figcaption>
</figure>
